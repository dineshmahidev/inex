{
  "expo": {
    "name": "Tracksy",
    "slug": "flow-ledger",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/app_logo.png",
    "notification": {
      "icon": "./assets/notification_icon.png",
      "color": "#fcd002"
    },
    "scheme": "flowledger",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#fcd002"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dineshmahidev.tracksy"
    },
    "android": {
      "package": "com.dineshmahidev.tracksy",
      "versionCode": 8,
      "allowBackup": true,
      "fullBackupOnly": false,
      "splash": {
        "backgroundColor": "#fcd002"
      },
"adaptiveIcon": {
          "backgroundColor": "#fcd002",
          "foregroundImage": "./assets/app_logo.png",
          "backgroundImage": "./assets/app_logo.png",
          "monochromeImage": "./assets/app_logo.png"
        },
      "config": {
        "googleMobileAdsAppId": "ca-app-pub-2141805169615611~2090173992"
      },
      "permissions": [
        "SCHEDULE_EXACT_ALARM",
        "POST_NOTIFICATIONS",
        "WAKE_LOCK",
        "RECEIVE_BOOT_COMPLETED"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#fcd002"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-2141805169615611~2090173992",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "delayAppMeasurementInit": true,
          "userTrackingUsageDescription": "This identifier will be used to deliver personalized ads to you."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification_icon.png",
          "color": "#fcd002",
          "sounds": [
            "./assets/mixkit_bell_notification_933.wav"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c52a9fb3-5fee-4b38-baf5-69277c257c02"
      }
    }
  }
}
